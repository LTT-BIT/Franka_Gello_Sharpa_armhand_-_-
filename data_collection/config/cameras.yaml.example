camera_bringup:
  # Replace all serials and semantics with the deployed physical identities.
  # start_recording.sh refuses REPLACE_* values.
  # Copy to cameras.yaml locally; do not commit real serial numbers.
  cam0:
    # Optional: direct connection to the deployed camera, bypassing discovery.
    # net_device_ip: 192.168.1.123
    # net_device_port: 8090
    serial_number: REPLACE_CAM0_SERIAL
    semantic: REPLACE_CAM0_SEMANTIC
    config_file: camera_primary_params.yaml
    start_delay_sec: 4.0
  cam1:
    serial_number: REPLACE_CAM1_SERIAL
    semantic: REPLACE_CAM1_SEMANTIC
    config_file: camera_cam1_global_params.yaml
    start_delay_sec: 2.0
  cam2:
    serial_number: REPLACE_CAM2_SERIAL
    semantic: REPLACE_CAM2_SEMANTIC
    config_file: camera_secondary_params.yaml
    start_delay_sec: 0.0
  log_level: none
