TELEOP_DATA_ROOT=/home/descfly/franka_teleop_data
TELEOP_ROS_DOMAIN_ID=0
TELEOP_CONTROL_PORT=5590
PRESET_IK_PORT=5591
COLLECTION_CONTROL_PORT=5592
FRANKA_CPUSET=16-23
FRANKA_TELEOP_CPUSET=16-23
HOUSEKEEPING_CPUSET=0-15
FRANKA_ROBOT_CONFIG=/workspace/franka_upper_body_teleop/config/workcell/current.yaml

# The root-level 一键安装环境.sh replaces these with absolute paths to the
# self-contained dependencies copied with this project.
GELLO_SOFTWARE_ROOT=/absolute/path/to/gello_upper_body_teleop/portable_deps/gello_software
LITCHI_REPO=/absolute/path/to/gello_upper_body_teleop/portable_deps/litchi_hardware

# LitchiBot CPython 3.10 SDK and its independent headless worker runtime.
# The hands wrapper and hands-only dry-run load these keys automatically.
LITCHIBOT_PYTHON=/absolute/path/to/gello_upper_body_teleop/portable_deps/litchibot_runtime/bin/python
LITCHIBOT_SDK_ROOT=/absolute/path/to/gello_upper_body_teleop/portable_deps/litchibot_glove
LITCHIBOT_DATA_DIR=/absolute/path/to/gello_upper_body_teleop/portable_deps/litchibot_glove/user_data

# After reading ros_ws/src/orbbec_camera/SDK/End User License Agreement.txt,
# set to YES on this machine. Leave unset or empty to keep three-camera
# recording disabled. Do not commit this file.
# ORBBEC_SDK_LICENSE_ACCEPTED=
