<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <Discovery>
      <!--
        This launch briefly runs more than ten ROS processes in one domain.
        With ROS_LOCALHOST_ONLY, Cyclone uses unicast participant indices on
        loopback; keep the bound finite while leaving enough startup headroom.
      -->
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
    </Discovery>
    <!-- Camera images exceed the stock Linux UDP receive buffer. Reliable
         fragment retransmits otherwise create large receive-time gaps.
         Install ops/setup/install_dds_buffers.sh on each workstation first.
         Fail explicitly rather than silently accepting an undersized buffer. -->
    <Internal>
      <SocketReceiveBufferSize min="8MiB" max="8MiB"/>
    </Internal>
  </Domain>
</CycloneDDS>
